    { "key": "cursor", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"a@b.com\",\n  \"username\": \"alice\",\n  \"password\": \"secret123\",\n  \"role\": \"CREATOR\"\n}" }
          }
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"emailOrUsername\": \"alice\",\n  \"password\": \"secret123\"\n}" }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] }
          }
        },
        {
          "name": "POST /auth/change-password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth","change-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"oldPassword\": \"secret123\",\n  \"newPassword\": \"newSecret456\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "POST /posts (create)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"İlk postum\",\n  \"content\": \"Merhaba!\",\n  \"isSecret\": false,\n  \"mediaUrl\": \"https://cdn.example.com/p.jpg\",\n  \"mediaType\": \"IMAGE\"\n}" }
          }
        },
        {
          "name": "GET /posts (feed)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/posts?take=20&cursor={{cursor}}", "host": ["{{baseUrl}}"], "path": ["posts"], "query": [ {"key":"take","value":"20"}, {"key":"cursor","value":"{{cursor}}"} ] }
          }
        },
        {
          "name": "GET /posts/user/:userId",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/posts/user/{{userId}}?take=20&cursor={{cursor}}", "host": ["{{baseUrl}}"], "path": ["posts","user","{{userId}}"], "query": [ {"key":"take","value":"20"}, {"key":"cursor","value":"{{cursor}}"} ] }
          }
        },
        {
          "name": "GET /posts/:postId",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts","{{postId}}"] }
          }
        },
        {
          "name": "DELETE /posts/:postId",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts","{{postId}}"] }
          }
        }
      ]
    },
    {
